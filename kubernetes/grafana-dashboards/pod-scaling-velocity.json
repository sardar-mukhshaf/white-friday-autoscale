{
  "dashboard": {
    "id": null,
    "title": "Pod Scaling Velocity",
    "tags": ["scaling", "karpenter", "whitefriday"],
    "timezone": "browser",
    "schemaVersion": 36,
    "panels": [
      {
        "id": 1,
        "title": "HPA Trigger to Node Ready",
        "type": "timeseries",
        "targets": [
          {
            "expr": "karpenter_nodes_created - kube_horizontalpodautoscaler_status_current_replicas",
            "legendFormat": "Scaling Delta",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": {
              "drawStyle": "line"
            }
          }
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Pods Scheduled per Minute",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(kube_pod_status_scheduled[1m]))",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 }
      },
      {
        "id": 3,
        "title": "Nodes Ready",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
            "refId": "A"
          }
        ],
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 }
      }
    ]
  }
}
